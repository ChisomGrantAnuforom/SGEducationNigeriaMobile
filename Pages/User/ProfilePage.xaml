<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SGEducationNigeriaMobile.Pages.User.ProfilePage"
             Title="My Profile"
             BackgroundColor="#F4F6F8">

    <!-- Back Arrow -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="True" IsVisible="True" />
    </Shell.BackButtonBehavior>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <!-- Header -->
            <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                <Image Source="student_icon.png"
                       WidthRequest="70"
                       HeightRequest="70"
                       Aspect="AspectFill">
                    <Image.Clip>
                        <EllipseGeometry Center="35,35" RadiusX="35" RadiusY="35" />
                    </Image.Clip>
                </Image>

                <VerticalStackLayout>
                    <Label Text="Your Profile"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="#1F2937" />

                    <Label Text="Update your personal information"
                           FontSize="14"
                           TextColor="#6B7280" />
                </VerticalStackLayout>
            </HorizontalStackLayout>


            <!-- Profile Card -->
            <Frame CornerRadius="20"
                   Padding="20"
                   HasShadow="True"
                   BackgroundColor="White">

                <VerticalStackLayout Spacing="14">

                    <Entry x:Name="EntryFirstName"
                           Placeholder="First Name"
                           HeightRequest="50"
                           BackgroundColor="#F9FAFB"
                           TextColor="Black" />

                    <Entry x:Name="EntrySurname"
                           Placeholder="Surname"
                           HeightRequest="50"
                           BackgroundColor="#F9FAFB"
                           TextColor="Black" />

                    <Entry x:Name="EntryEmail"
                           Placeholder="Email"
                           Keyboard="Email"
                           HeightRequest="50"
                           BackgroundColor="#F9FAFB"
                           TextColor="Black" />

                    <Entry x:Name="EntryPhoneNumber"
                           Placeholder="Phone"
                           Keyboard="Telephone"
                           HeightRequest="50"
                           BackgroundColor="#F9FAFB"
                           TextColor="Black" />

                    <!-- Password Section -->
                    <Label Text="Security"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1F2937"
                           Margin="0,10,0,0" />

                    <Entry x:Name="EntryPassword"
                           Placeholder="Password"
                           IsPassword="True"
                           HeightRequest="50"
                           BackgroundColor="#F9FAFB"
                           TextColor="Black" />

                    <Entry x:Name="EntryConfirmPassword"
                           Placeholder="Confirm Password"
                           IsPassword="True"
                           HeightRequest="50"
                           BackgroundColor="#F9FAFB"
                           TextColor="Black" />

                    <!-- Save Button -->
                    <Button Text="Save Changes"
                            HeightRequest="50"
                            CornerRadius="12"
                            BackgroundColor="#4F46E5"
                            TextColor="White"
                            Clicked="OnSaveProfileClicked" />

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
