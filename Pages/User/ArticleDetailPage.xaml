<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SGEducationNigeriaMobile.Pages.User.ArticleDetailPage"
             BackgroundColor="#F5F6FA">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- HEADER / HERO SECTION -->
            <Grid HeightRequest="180">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Black" Offset="0.0" />
                        <GradientStop Color="#11589C" Offset="1.0" />
                    </LinearGradientBrush>
                </Grid.Background>

                <!-- <VerticalStackLayout Padding="20" VerticalOptions="End"> -->
                    <Label Text="{Binding Title}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"
                           Margin="0, 30, 0, 0"
                           LineBreakMode="WordWrap" />
                <!-- </VerticalStackLayout> -->
            </Grid>


            <!-- CONTENT CARD -->
            <Frame Margin="15,-40,15,20"
                   Padding="20"
                   CornerRadius="20"
                   BackgroundColor="White"
                   HasShadow="True">

                <VerticalStackLayout Spacing="15">

                    <!-- META INFO -->
                    <HorizontalStackLayout Spacing="10">
                        
                        <Label Text="{Binding CreatedAt, StringFormat='{0:dd MMM yyyy}'}"
                               FontSize="13"
                               TextColor="#757575" />

                        <Label Text="•"
                               FontSize="13"
                               TextColor="#757575" />

                        <Label Text="{Binding Category}"
                               FontSize="13"
                               TextColor="#757575" />
                        
                    </HorizontalStackLayout>

                    <!-- ARTICLE BODY -->
                    <Label Text="{Binding Body}"
                           FontSize="17"
                           TextColor="#333333"
                           LineBreakMode="WordWrap" />

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>



