            <!-- ARTICLES SECTION -->
            <Label Text="EDU ARTICLES:"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#1A1A1A"
                   Margin="0,20,0,0" />

            <CollectionView x:Name="ArticleListView"
                            SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="15"
                               Margin="0,0,0,15"
                               BorderColor="#E0E0E0"
                               CornerRadius="12"
                               BackgroundColor="White"
                               HasShadow="True">

                            <VerticalStackLayout Spacing="10">

                                <Label Text="{Binding Title}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#1A1A1A" />

                                <Label Text="{Binding CreatedAt, StringFormat='Published: {0:dd MMM yyyy}'}"
                                       FontSize="13"
                                       TextColor="#757575" />

                                <Button Text="View Article"
                                        BackgroundColor="LightSlateGray"
                                        TextColor="White"
                                        CornerRadius="8"
                                        Padding="8"
                                        Clicked="OnViewArticleClicked" />

                            </VerticalStackLayout>

                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
            


